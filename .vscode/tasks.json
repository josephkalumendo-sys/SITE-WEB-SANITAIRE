{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Commit automatique après sauvegarde",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\auto-commit-on-save.ps1"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
